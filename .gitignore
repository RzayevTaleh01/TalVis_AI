# ── Secrets. Committing any of these publishes them. ──────────────────────────
# your Gemini API key, plus per-plugin credentials
config/api_keys.json
# the dashboard's TLS private key and certificate
config/certs/
# a LINKED WhatsApp session — committing it hands
config/whatsapp_web/
# somebody your WhatsApp account, not just a key
# Google OAuth tokens (Gmail / Calendar plugins)
**/token*.json
# Google OAuth client secrets
**/client_secret*.json
*credentials*.json
.env
.env.*

# ── Personal data the assistant accumulates about you ─────────────────────────
memory/long_term.json
memory/*.db

# ── Python build noise ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Editors and operating systems ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Runtime output ────────────────────────────────────────────────────────────
*.log
*.log.*
logs/
downloads/
screenshots/

# The record of what was delegated and how it went — local history.
memory/journal.json
# The assistant's working picture of you — personal, local.
memory/understanding.json
